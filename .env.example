# Шаблон окружения Докуматики. Скопируйте и заполните:
#   cp .env.example .env
#
# Секретов в этом файле быть не должно — он лежит в git. Настоящие пароли живут
# только в .env на сервере (chmod 600, владелец — пользователь сервиса).
# Приложение читает переменные ИЗ ОКРУЖЕНИЯ, а не из файла: локально их
# подставляет `make run`, в проде — systemd через EnvironmentFile.
#
# Пустое значение = «взять значение по умолчанию из кода». Флаги: 1/0.


# ────────────────────────────────── рантайм ──────────────────────────────────

# Слушаем только локальный интерфейс: наружу смотрит nginx, он же держит TLS.
APP_HOST=127.0.0.1

# 8081 — порт этого проекта на общем сервере (8080 занят соседним).
# Значение по умолчанию в коде — 8080; в nginx и systemd должен стоять тот же порт.
APP_PORT=8081

# Файл базы. Каталог var/ создаётся приложением, в git не попадает.
DATABASE_PATH=var/dokumatika.sqlite3

# Каталог статики. Пусто = src/static рядом с кодом. Менять почти никогда не нужно.
STATIC_ROOT=

# Подробные ошибки в ответах. В проде строго 0.
APP_DEBUG=0

# Мягкий kill-switch: сайт отдаёт заглушку. Альтернатива без перезапуска сервиса —
# создать файл-маркер: touch var/MAINTENANCE (удалить, чтобы выключить режим).
MAINTENANCE=0

# Рубильник приёма оплаты. 0 — кнопки оплаты скрыты, бесплатный генератор работает.
PAYMENTS_ENABLED=1

# Доступ к /admin/. Пусто = админка выключена целиком.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Версия статики в ссылках вида /styles.css?v=... — nginx кэширует их на год.
# МЕНЯЙТЕ ПРИ КАЖДОЙ ПРАВКЕ css или js, иначе посетитель останется на старом файле.
ASSET_VERSION=20260726-3


# ─────────────────────────────────── сайт ────────────────────────────────────

# Домен без схемы и слэша. Из него собираются canonical, sitemap и ссылки в письмах.
SITE_DOMAIN=dokumatika.ru
SITE_SCHEME=https

# Номер счётчика Яндекс.Метрики. Пусто = счётчик не подключается вовсе.
METRIKA_ID=

# Ключ IndexNow (Яндекс/Bing): произвольная строка 8–128 символов [a-zA-Z0-9-].
# Приложение само отдаёт файл-подтверждение /<КЛЮЧ>.txt, класть его руками не нужно.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(16))"
INDEXNOW_KEY=

# Почта для связи на страницах. Пусто = подставится SELLER_EMAIL.
SUPPORT_EMAIL=


# ──────────────────────── реквизиты продавца (обязательно) ───────────────────
#
# Robokassa требует, чтобы реквизиты были видны на сайте (подвал + оферта).
# Пока поля пустые, страница оферты показывает предупреждение, а `make preflight`
# не пропускает выкатку. Ничего не выдумывайте — данные должны совпадать с
# «Мой налог» / ЕГРИП.

# Самозанятый | ИП | ООО
SELLER_LEGAL_FORM=Самозанятый
# ФИО полностью (для ООО — наименование)
SELLER_NAME=
SELLER_INN=
# ОГРН/ОГРНИП. У самозанятого-физлица его нет — оставьте пустым.
SELLER_OGRN=
SELLER_EMAIL=
# Для самозанятого достаточно города (домашний адрес публиковать не нужно).
SELLER_ADDRESS=


# ─────────────────────────────────── SMTP ────────────────────────────────────
#
# Письмо со ссылкой на документы — дубль: ссылка и так показана покупателю сразу
# после оплаты. Если SMTP не настроен, выдача не ломается, в лог пишется пропуск.

SMTP_HOST=
# 587 — STARTTLS. Порт 465 (implicit SSL) не поддерживается: клиент делает
# обычное соединение и STARTTLS поверх него.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Адрес в поле «От кого». Пусто = SMTP_USER. Домен должен совпадать с SPF/DKIM.
SMTP_SENDER=
SMTP_USE_TLS=1


# ───────────────────────────────── Robokassa ─────────────────────────────────
#
# Заполняется из ЛК: «Мои магазины» → «Технические настройки».
# Пока логин или пароли пустые, интеграция считается ненастроенной и оплата
# выключена — сайт при этом работает.
#
# Адреса, которые нужно вписать в ЛК (метод — POST):
#   ResultURL  https://dokumatika.ru/robokassa/result
#   SuccessURL https://dokumatika.ru/oplata/uspeh/
#   FailURL    https://dokumatika.ru/oplata/otmena/

ROBOKASSA_MERCHANT_LOGIN=
# Password #1 — подпись исходящей формы оплаты.
ROBOKASSA_PASSWORD1=
# Password #2 — проверка подписи входящего ResultURL. Самый чувствительный секрет:
# кто знает его, тот может подделать уведомление об оплате.
ROBOKASSA_PASSWORD2=

# Отдельная пара паролей тестового режима (в ЛК своя вкладка).
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
# 1 — оплата идёт в тестовом контуре, деньги не списываются.
ROBOKASSA_TEST_MODE=0

# ВНИМАНИЕ: алгоритм ОБЯЗАН совпадать с выбранным в ЛК Robokassa. По умолчанию в
# кабинете стоит MD5 — если здесь оставить sha256, а там не переключить, платёж
# упадёт с ошибкой 29 («неверная подпись»). Меняйте в двух местах одновременно.
# Допустимо: md5, sha1, sha256, sha384, sha512.
ROBOKASSA_HASH_ALGORITHM=sha256

# Фискальный чек. Для самозанятого чек формируют «Робочеки СМЗ» — бесплатный
# сервис Robokassa; его нужно разрешить в приложении «Мой налог».
# Товар цифровой и передаётся сразу после оплаты, НДС нет (НПД).
ROBOKASSA_RECEIPT_PAYMENT_METHOD=full_payment
ROBOKASSA_RECEIPT_PAYMENT_OBJECT=service
ROBOKASSA_RECEIPT_TAX=none
