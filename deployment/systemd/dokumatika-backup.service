# Разовый запуск резервного копирования базы. Запускается таймером,
# вручную — `systemctl start dokumatika-backup`.
#
# Установка: /etc/systemd/system/dokumatika-backup.service
# Каталог назначения нужно создать заранее (ProtectSystem=strict не даст
# создать его самому сервису):
#   install -d -o dokumatika -g dokumatika -m 0750 /var/backups/dokumatika

[Unit]
Description=Резервная копия базы Докуматики
Documentation=file:///opt/dokumatika/deployment/ROLLOUT.md
# RU: Не «требует» сервис, а лишь идёт после него: копия живой базы снимается
# без остановки сайта, и остановленный сайт бэкапу тоже не мешает.
After=dokumatika.service

[Service]
Type=oneshot
User=dokumatika
Group=dokumatika
Slice=apps.slice

Environment=DATABASE_PATH=/var/lib/dokumatika/dokumatika.sqlite3
Environment=BACKUP_DIR=/var/backups/dokumatika
Environment=BACKUP_KEEP=14
Environment=LANG=C.UTF-8
# RU: .env читается ПОСЛЕ значений выше и перекрывает их. Это важно: если в
# .env указан другой DATABASE_PATH (например, база переехала), бэкап обязан
# следовать за ней, а не молча копировать пустой файл по старому пути.
# `-` перед путём — файл необязателен, без него юнит не упадёт.
EnvironmentFile=-/etc/dokumatika/.env
ExecStart=/opt/dokumatika/scripts/backup.sh

# RU: Бэкап не должен конкурировать с отдачей страниц за диск и процессор.
Nice=10
IOSchedulingClass=idle
CPUQuota=40%
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=256M
TasksMax=32
TimeoutStartSec=600

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dokumatika-backup

# ----------------------------------------------------------------- защита
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# RU: Каталог базы нужен на ЗАПИСЬ даже для чтения: открывая базу в режиме WAL,
# SQLite обновляет разделяемый индекс -shm. С правами «только чтение» бэкап
# упал бы с «attempt to write a readonly database» на живой базе.
ReadWritePaths=/var/lib/dokumatika /var/backups/dokumatika

PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# RU: AF_UNIX — journald. Сеть скрипту не нужна, но AF_INET оставлен на случай
# выгрузки копии наружу (см. комментарий в scripts/backup.sh).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
