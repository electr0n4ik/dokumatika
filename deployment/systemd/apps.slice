# Групповой потолок для всех прикладных проектов сервера.
#
# Зачем слайс, если у каждого сервиса уже есть свои лимиты: индивидуальные
# лимиты защищают соседей от одного взбесившегося проекта, но не защищают
# систему от суммы пяти проектов, каждый из которых «в рамках». Слайс — это
# второй, групповой рубеж: 5 x 320M по MemoryMax = 1600M, а групповой MemoryMax
# 2200M не даст им вместе выесть всю память, если добавится шестой.
#
# Расчёт под 2 vCPU / 4 GB:
#   4096M всего − ~350M система и journald − ~150M nginx − ~1200M страничный кэш
#   и запас, чтобы OOM killer никогда не пришёл за sshd = ~2200M приложениям.
#   CPUQuota=150% из 200% доступных: четверть ядра всегда остаётся системе,
#   иначе под нагрузкой не зайти по ssh и не перезапустить сервис.
#
# Установка: /etc/systemd/system/apps.slice, затем `systemctl daemon-reload`.
# Сервисы попадают сюда строкой `Slice=apps.slice`.

[Unit]
Description=Слайс прикладных веб-проектов (общий потолок ресурсов)
Before=slices.target

[Slice]
# RU: Учёт обязателен явно — без *Accounting лимиты на старых systemd молча
# не применяются, а `systemctl status` показывает прочерки вместо цифр.
MemoryAccounting=yes
# RU: MemoryHigh — мягкий порог: ядро начинает агрессивно вытеснять кэш и
# притормаживать группу, но процессы живут. MemoryMax — жёсткий, за ним OOM.
MemoryHigh=1600M
MemoryMax=2200M
# RU: Немного свопа группе разрешено: это подушка на пик, а не режим работы.
# Отдельным проектам своп запрещён (MemorySwapMax=0), чтобы отвечающий на HTTP
# процесс никогда не уходил в диск.
MemorySwapMax=256M

CPUAccounting=yes
CPUQuota=150%
CPUWeight=100

TasksAccounting=yes
TasksMax=1024

IOAccounting=yes
# RU: Вес ниже дефолтного (100): при дисковой конкуренции с бэкапом и системой
# отдача страниц важнее, но приоритет системных задач всё же выше.
IOWeight=100
